rules_version = '2';

// Version 1: Jeder angemeldete Nutzer der App darf alles lesen und schreiben
// (keine Rollen, siehe CLAUDE.md). Wer nicht angemeldet ist, sieht nichts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
